 <office:body>
  <office:text>
   <text:sequence-decls>
    <text:sequence-decl text:display-outline-level="0" text:name="Illustration"/>
    <text:sequence-decl text:display-outline-level="0" text:name="Table"/>
    <text:sequence-decl text:display-outline-level="0" text:name="Text"/>
    <text:sequence-decl text:display-outline-level="0" text:name="Drawing"/>
    <text:sequence-decl text:display-outline-level="0" text:name="Figure"/>
   </text:sequence-decls>
   <text:p text:style-name="P1"><text:span text:style-name="T1">2</text:span><text:span text:style-name="T2">е </text:span><text:span text:style-name="T1">Приложение</text:span> к договору</text:p>
   <text:p text:style-name="P1">материальной ответственностью</text:p>
   <text:p text:style-name="P1">№_________ от «___»___________202_г.</text:p>
   <text:p text:style-name="P2"/>
   <text:p text:style-name="P2"/>
   <text:p text:style-name="P2"/>
   <text:p text:style-name="P2"/>
   <text:p text:style-name="P2"/>
   <text:p text:style-name="P2"/>
   <text:p text:style-name="P2"/>
   <text:p text:style-name="P3">АКТ</text:p>
   <text:p text:style-name="P3">приема-передачи ноутбука</text:p>
   <text:p text:style-name="P4"><text:s text:c="83"/><text:span text:style-name="T3">$DATE$</text:span></text:p>
   <text:p text:style-name="P5"><text:s/></text:p>
   <text:p text:style-name="P6"><text:span text:style-name="T3">ООО «</text:span><text:span text:style-name="T4">Цирк без Коней»</text:span><text:span text:style-name="T3">, в лице </text:span><text:span text:style-name="T5">главного клоуна</text:span><text:span text:style-name="T3">, $FIO_GENITIVE_REG$, </text:span><text:bookmark-start text:name="_Hlk38639603"/><text:span text:style-name="T3">действующего по доверенности, </text:span><text:bookmark-end text:name="_Hlk38639603"/><text:span text:style-name="T3">передал</text:span><text:span text:style-name="T6">(а)</text:span><text:span text:style-name="T3"> ноутбук марки $MODEL$, номер $SERIAL$ <text:s/>для использования в рабочих целях, $JOB_TITLE$ $FIO_DATV$.</text:span></text:p>
   <text:p text:style-name="P7"/>
   <text:p text:style-name="P8"><text:span text:style-name="T7">А $FIO_FULL$ приняла(а) ноутбук мар</text:span><text:span text:style-name="T3">ки $MODEL$</text:span><text:span text:style-name="T8">, номе</text:span><text:span text:style-name="T3">р $SERIAL$ на</text:span></text:p>
   <text:p text:style-name="P9"><text:span text:style-name="T3">ответственное хранение</text:span>,<text:span text:style-name="T3"> о чем составлен настоящий Акт.</text:span></text:p>
   <text:p text:style-name="P9"><text:span text:style-name="T3">Акт составлен в двух экземплярах. Один хранится у $FIO_GENITIVE_REG$, второй у </text:span><text:span text:style-name="T9">$FIO_GENITIVE$</text:span></text:p>
   <text:p text:style-name="P10"/>
   <text:p text:style-name="P11"/>
   <text:p text:style-name="P12"/>
   <text:p text:style-name="P13"/>
   <text:p text:style-name="P13"/>
   <text:p text:style-name="P13"/>
   <text:p text:style-name="P12"/>
   <text:p text:style-name="P14"/>
   <text:p text:style-name="P15"/>
   <text:p text:style-name="P15">Передал<text:tab/><text:tab/><text:tab/><text:tab/><text:tab/><text:tab/><text:tab/>Принял</text:p>
   <text:p text:style-name="P16"><text:span text:style-name="T3">$FIO_SHORT_REG$.<text:tab/><text:tab/><text:tab/><text:tab/><text:tab/><text:tab/></text:span><text:span text:style-name="T3">$FIO_SHORT$.</text:span></text:p>
   <text:p text:style-name="P17"><text:span text:style-name="T3">ООО «</text:span><text:span text:style-name="T4">Цирк без Коней»</text:span><text:span text:style-name="T3"><text:tab/><text:tab/><text:tab/><text:tab/><text:tab/>ООО «</text:span><text:span text:style-name="T4">Цирк без Коней»</text:span></text:p>
   <text:p text:style-name="P18"/>
   <text:p text:style-name="P19"/>
   <text:p text:style-name="P20">_______________________/_________./ <text:s text:c="34"/>_______________________/_________./</text:p>
   <text:p text:style-name="P15"/>
   <text:p text:style-name="P21">Дата<text:tab/>______________________________<text:tab/><text:tab/><text:tab/>Дата <text:s text:c="3"/>______________________________</text:p>
  </office:text>
 </office:body>
</office:document>